{
  "name": "@gugu/community-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/push/*.test.mjs && vitest run --project unit",
    "test:push": "node --test tests/push/*.test.mjs",
    "check:edge-logs": "node scripts/check-edge-log-outlets.mjs",
    "test:invitation-smtp": "DENO_NO_PACKAGE_JSON=1 deno test --no-config --lock=deno.lock --frozen --allow-net=127.0.0.1 --allow-env --allow-sys=hostname,networkInterfaces --allow-run=openssl,python3 --allow-read --allow-write tests/deno/teamInvitationSmtp.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "check:functions": "deno check supabase/functions/server-login/index.ts supabase/functions/attachments/index.ts supabase/functions/account-deletion/index.ts supabase/functions/team-accounts/index.ts",
    "setup": "node scripts/setup.mjs",
    "test:db:start": "node scripts/test-db.mjs start",
    "test:db:stop": "node scripts/test-db.mjs stop",
    "test:installation": "node --test tests/installation/*.test.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@hocuspocus/provider": "4.7.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "jose": "6.2.12",
    "pg": "8.16.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yjs": "13.6.33",
    "supabase": "2.106.0"
  }
}
